GITHUB_TOKEN=$(gh auth token) || return 1
TF_VAR_github_app_client_id=$(op read "op://github-infra/gpy6ac6xvvt3oh6bgemg3cbc6u/client_id") || return 1
TF_VAR_github_app_private_key=$(op read "op://github-infra/gpy6ac6xvvt3oh6bgemg3cbc6u/app.private-key.pem") || return 1
export GITHUB_TOKEN TF_VAR_github_app_client_id TF_VAR_github_app_private_key
